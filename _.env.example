# Required: 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000
DB_FILE=bank.db
# true = shows a "Add test money" button. NEVER enable with real users.
DEMO_MODE=false
# Max single transfer in paise (10000000 = Rs 1,00,000)
MAX_TRANSFER_PAISE=10000000

# Razorpay TEST keys (Dashboard > Settings > API Keys, in Test Mode). Keep the secret on the server only.
RZP_KEY_ID=
RZP_KEY_SECRET=
